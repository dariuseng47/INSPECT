# คัดลอกเป็น .env แล้วกรอกค่าจริงของเครื่องนี้ (.env ไม่ถูก commit เข้า git — ดู .gitignore root)

NODE_ENV=development
PORT=4000

# origin ของ dashboard ที่อนุญาตให้เรียก API นี้ได้ — คั่นด้วย , ได้หลายค่า
# dev (NODE_ENV != production): origin ในวงแลน (localhost/192.168.x.x/10.x.x.x) ผ่านอัตโนมัติอยู่แล้ว
#   ไม่ต้องเพิ่มในนี้ ดู server/src/config/env.js#isAllowedOrigin
# production: ต้องระบุ origin จริงของ dashboard ให้ตรงเป๊ะ (scheme + host, ไม่มี path ต่อท้าย)
CORS_ORIGIN=http://localhost:3033
# production ตัวอย่าง (welcleankhoka.com):
# NODE_ENV=production
# CORS_ORIGIN=https://welcleankhoka.com

# ===== MySQL Database =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CONNECTION_LIMIT=10

# ===== JWT Secrets (สุ่มค่าใหม่ทุกเครื่อง ต้องยาวอย่างน้อย 32 ตัวอักษร) =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
SESSION_MAX_TTL_HOURS=8

# ใช้ทำ HMAC ของ PIN login 6 หลัก (สุ่มค่าใหม่ทุกเครื่อง ยาวอย่างน้อย 32 ตัวอักษร —
# ถ้าเปลี่ยนค่านี้ทีหลัง PIN เดิมของทุกคนจะใช้ไม่ได้)
PIN_PEPPER=
