# คัดลอกเป็น .env แล้วปรับตามที่รัน (.env ไม่ถูก commit เข้า git — ดู .gitignore root)
# ต้องมี /api/v1 ต่อท้ายเสมอ (ดู server/src/app.js — mount ที่ /api/v1)

# Server url — ชี้ไปที่ backend (server/)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000/api/v1
# production ตัวอย่าง:
# NEXT_PUBLIC_SERVER_URL=https://api.example.com/api/v1

# Public resource directory
NEXT_PUBLIC_ASSETS_DIR=
